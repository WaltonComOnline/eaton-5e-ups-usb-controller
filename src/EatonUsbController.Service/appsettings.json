{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EatonUsbController": {
    "Nut": {
      "UpsName": "eaton",
      "Host": "127.0.0.1",
      "Port": 3493,
      "Username": "",
      "Password": "",
      "NutBinPath": "C:/NUT/bin",
      "NutConfPath": "C:/NUT/etc"
    },
    "Beeper": {
      "Mode": "AlwaysOff",
      "Schedule": []
    },
    "Shutdown": {
      "Enabled": false,
      "BatteryThresholdPercent": 20,
      "RuntimeThresholdSeconds": 120,
      "GracePeriodSeconds": 30,
      "UseHibernate": false,
      "CustomShutdownCommand": ""
    },
    "Alerts": {
      "Email": {
        "Enabled": false,
        "SmtpHost": "",
        "SmtpPort": 587,
        "UseTls": true,
        "Username": "",
        "Password": "",
        "FromAddress": "",
        "ToAddresses": []
      },
      "WebhookUrls": [],
      "EnabledEventTypes": [
        "PowerLost",
        "PowerRestored",
        "BatteryLow",
        "ShutdownInitiated",
        "ForcedShutdown"
      ]
    },
    "ScriptTriggers": [],
    "PollIntervalMs": 2000,
    "EventRetentionDays": 90
  }
}
