<Window x:Class="EatonUsbController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EatonUsbController.App.ViewModels"
        xmlns:conv="clr-namespace:EatonUsbController.App.Converters"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="Eaton 5E Controller" 
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:RuntimeConverter x:Key="RuntimeConverter" />
        <conv:PercentConverter x:Key="PercentConverter" />
        <conv:VoltageConverter x:Key="VoltageConverter" />
        <conv:PageVisibilityConverter x:Key="PageVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Form control styles -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Toggle button (entire clickable area) -->
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{StaticResource SurfaceBrush}" 
                                                BorderBrush="{StaticResource CardBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Arrow glyph -->
                                                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextDimBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Selected item text display -->
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="10,7,28,7"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextBlock.Foreground="{StaticResource TextBrush}" />

                            <!-- Editable textbox (hidden for non-editable) -->
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Background="Transparent" Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}" BorderThickness="0"
                                     Margin="10,7,28,7" VerticalAlignment="Center"
                                     Focusable="True" />

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{StaticResource SurfaceBrush}" 
                                            BorderBrush="{StaticResource CardBrush}" BorderThickness="1" CornerRadius="6"
                                            Margin="0,2,0,0" Padding="0,4">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="3" Opacity="0.4" BlurRadius="8" />
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="InfoTip" TargetType="TextBlock">
            <Setter Property="Text" Value=" ℹ" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="{Binding TrayTooltip}"
                        DoubleClickCommand="{Binding ShowWindowCommand}"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Eaton 5E Controller" Click="ShowWindow_Click" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="{Binding UpsState}" IsEnabled="False" />
                    <MenuItem Header="{Binding BeeperStatus, StringFormat='Beeper: {0}'}" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="Toggle Beeper" Command="{Binding ToggleBeeperCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== SIDE NAVIGATION ===== -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="8,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,20">
                        <Image Source="eaton-logo.png" Height="28" HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <TextBlock Text="5E Controller" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextDimBrush}" />
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" 
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="4,8,4,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding UpsState}" Foreground="{StaticResource TextBrush}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Manufacturer" />
                                        <Binding Path="Model" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Nav buttons with active state highlighting -->
                    <StackPanel>
                        <Button Content="📊 Dashboard" Click="NavDashboard_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="Dashboard">
                                            <Setter Property="Background" Value="#2E1F5E" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🔔 Beeper" Click="NavBeeper_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="Beeper">
                                            <Setter Property="Background" Value="#2E1F5E" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="📋 Events" Click="NavEvents_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="Events">
                                            <Setter Property="Background" Value="#2E1F5E" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="⚙️ Shutdown" Click="NavShutdown_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="Shutdown">
                                            <Setter Property="Background" Value="#2E1F5E" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="📧 Alerts" Click="NavAlerts_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="Alerts">
                                            <Setter Property="Background" Value="#2E1F5E" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="📜 Scripts" Click="NavScripts_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="Scripts">
                                            <Setter Property="Background" Value="#2E1F5E" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🔧 NUT / Advanced" Click="NavNut_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="NUT">
                                            <Setter Property="Background" Value="#2E1F5E" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🚪 Exit" Click="Exit_Click" DockPanel.Dock="Bottom"
                                Style="{StaticResource NavButton}" Foreground="#FF6B6B" Margin="0,20,0,0" />

                        <!-- Version footer -->
                        <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="9" Margin="4,8,0,0" Opacity="0.6">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="v{0} — {1}">
                                    <Binding Path="AppVersion" />
                                    <Binding Path="AppAuthor" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== MAIN CONTENT AREA ===== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <Grid>

                    <!-- ========== DASHBOARD PAGE ========== -->
                    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource PageVis}, ConverterParameter=Dashboard}">

                        <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                        <!-- ===== SYNOPTIC POWER FLOW DIAGRAM ===== -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <TextBlock Text="POWER FLOW" Style="{StaticResource MetricLabel}" Margin="0,0,0,12" />
                                <Canvas Height="100" ClipToBounds="False">
                                    <!-- AC Input / Mains -->
                                    <Border Canvas.Left="0" Canvas.Top="20" Width="90" Height="60" 
                                            CornerRadius="6" Padding="6" Background="{StaticResource SurfaceBrush}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding PowerSourceLabel}" FontSize="10" 
                                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Arrow 1: Input → UPS -->
                                    <TextBlock Canvas.Left="96" Canvas.Top="38" Text="▶▶▶" FontSize="16"
                                               Foreground="{Binding PowerFlowColor}" />

                                    <!-- UPS Unit (Eaton 5E) -->
                                    <Border Canvas.Left="145" Canvas.Top="10" Width="130" Height="80" 
                                            CornerRadius="8" Padding="6" BorderThickness="2" BorderBrush="{StaticResource EatonBlueBrush}"
                                            Background="{StaticResource SurfaceBrush}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🔋" FontSize="22" HorizontalAlignment="Center" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Manufacturer" />
                                                        <Binding Path="Model" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,2,4,0" />
                                                <TextBlock Text="{Binding UpsState}" FontSize="10" 
                                                           Foreground="{Binding StatusColor}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Arrow 2: UPS → Output -->
                                    <TextBlock Canvas.Left="281" Canvas.Top="38" Text="▶▶▶" FontSize="16"
                                               Foreground="{Binding PowerFlowColor}" />

                                    <!-- Output / Protected Equipment -->
                                    <Border Canvas.Left="330" Canvas.Top="20" Width="100" Height="60"
                                            CornerRadius="6" Padding="6" Background="{StaticResource SurfaceBrush}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🖥️" FontSize="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="Protected" FontSize="10" 
                                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Battery indicator below UPS -->
                                    <Border Canvas.Left="165" Canvas.Top="93" Width="90" Height="5" 
                                            CornerRadius="2" Background="{StaticResource SurfaceBrush}">
                                        <ProgressBar Value="{Binding BatteryCharge}" Maximum="100" Height="5"
                                                     Foreground="{StaticResource GreenBrush}" Background="Transparent"
                                                     BorderThickness="0" />
                                    </Border>

                                    <!-- Input voltage label -->
                                    <TextBlock Canvas.Left="10" Canvas.Top="83" FontSize="10" Foreground="{StaticResource TextDimBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="InputVoltage" StringFormat="{}{0:F0}V" />
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- Output voltage label -->
                                    <TextBlock Canvas.Left="345" Canvas.Top="83" FontSize="10" Foreground="{StaticResource TextDimBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="OutputVoltage" StringFormat="{}{0:F0}V" />
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- Load at output -->
                                    <TextBlock Canvas.Left="440" Canvas.Top="40" FontSize="10" Foreground="{StaticResource TextDimBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="Load" StringFormat="Load: {0:F0}%" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Canvas>
                            </StackPanel>
                        </Border>

                        <!-- ===== STATUS CARDS (IPP-style Information and Status) ===== -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Information and Status -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                                <StackPanel>
                                    <TextBlock Text="INFORMATION &amp; STATUS" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Power Source" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding PowerSourceLabel}" Foreground="{StaticResource TextBrush}" FontSize="12" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="UPS State" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpsState}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Text="Battery Charge" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding BatteryCharge}" Maximum="100" Width="80" Height="10"
                                                         Foreground="{StaticResource GreenBrush}" Background="{StaticResource SurfaceBrush}" />
                                            <TextBlock Text="{Binding BatteryCharge, Converter={StaticResource PercentConverter}}" 
                                                       Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Text="Battery Runtime" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BatteryRuntime, Converter={StaticResource RuntimeConverter}}" 
                                                   Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="4" Text="Load Level" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding Load}" Maximum="100" Width="80" Height="10"
                                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceBrush}" />
                                            <TextBlock Text="{Binding Load, Converter={StaticResource PercentConverter}}" 
                                                       Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="5" Text="Beeper" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BeeperStatus}" 
                                                   Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="6" Text="Master Output" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding OutletStatus, TargetNullValue='On'}" Foreground="{StaticResource TextBrush}" FontSize="12" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="7" Text="Power Rating" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"
                                                   Text="{Binding PowerNominal, StringFormat='{}{0:F0} VA'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Right: Measures -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                                <StackPanel>
                                    <TextBlock Text="MEASURES" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                        </Grid.RowDefinitions>

                                        <!-- Input section -->
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="── Input ──" 
                                                   FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="1" Text="Input Voltage" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                                   Text="{Binding InputVoltage, StringFormat='{}{0:F1} V'}" />

                                        <TextBlock Grid.Row="2" Text="Frequency" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                                   Text="{Binding OutputFrequencyNominal, StringFormat='{}{0:F0} Hz'}" />

                                        <!-- Output section -->
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="── Output ──" 
                                                   FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,4" />
                                        <TextBlock Grid.Row="4" Text="Output Voltage" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                                   Text="{Binding OutputVoltage, StringFormat='{}{0:F1} V'}" />

                                        <TextBlock Grid.Row="5" Text="Nominal Voltage" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                                   Text="{Binding OutputVoltageNominal, StringFormat='{}{0:F0} V'}" />

                                        <TextBlock Grid.Row="6" Text="Apparent Power" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                                   Text="{Binding PowerNominal, StringFormat='{}{0:F0} VA'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== UPS DEVICE INFO (IPP-style) ===== -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <TextBlock Text="DEVICE INFORMATION" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                                <UniformGrid Columns="5">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Manufacturer" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Manufacturer}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Model" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Model}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Serial" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Serial}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Firmware" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Firmware}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Battery Type" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding BatteryType}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="RECENT EVENTS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource AccentButton}" Content="Load History" 
                                            Command="{Binding LoadHistoryCommand}" Margin="12,0,0,0"
                                            FontSize="11" Padding="8,3" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding RecentEvents}" AutoGenerateColumns="False"
                                          IsReadOnly="True" MaxHeight="200" 
                                          Background="Transparent" Foreground="{StaticResource TextBrush}"
                                          GridLinesVisibility="None" BorderThickness="0"
                                          RowBackground="{StaticResource CardBrush}"
                                          AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                          HeadersVisibility="Column">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                            <Setter Property="Padding" Value="8,4" />
                                            <Setter Property="FontSize" Value="11" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="80" />
                                        <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="120" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <TextBlock Text="QUICK ACTIONS" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Style="{StaticResource AccentButton}" Content="🔋 Quick Battery Test" 
                                            Command="{Binding TestBatteryQuickCommand}" Margin="0,0,8,4"
                                            ToolTip="Run a ~10-second quick battery self-test. The UPS briefly switches to battery and back. Results appear in the event log." />
                                    <Button Style="{StaticResource AccentButton}" Content="🔋 Deep Battery Test" 
                                            Command="{Binding TestBatteryDeepCommand}" Margin="0,0,8,4"
                                            ToolTip="Run a full battery discharge test to measure actual runtime. The UPS runs on battery until charge drops to a threshold, then switches back. Can take several minutes." />
                                    <Button Style="{StaticResource AccentButton}" Content="⏹ Stop Battery Test" 
                                            Command="{Binding StopBatteryTestCommand}" Margin="0,0,8,4"
                                            ToolTip="Abort a running battery test and return to normal operation immediately." />
                                    <Button Style="{StaticResource AccentButton}" Content="🔔 Toggle Beeper" 
                                            Command="{Binding ToggleBeeperCommand}" Margin="0,0,8,4"
                                            ToolTip="Enable or disable the UPS audible alarm. Sends a persistent EEPROM command that survives power cycles and firmware upgrades." />
                                    <Button Style="{StaticResource AccentButton}" Content="🔇 Mute Beeper" 
                                            Command="{Binding MuteBeeperCommand}" Margin="0,0,8,4"
                                            ToolTip="Temporarily silence the UPS beeper for this session only. The beeper will re-enable on the next power event or UPS power cycle." />
                                    <Button Style="{StaticResource AccentButton}" Content="📊 Reset Min/Max" 
                                            Command="{Binding ResetInputMinMaxCommand}" Margin="0,0,8,4"
                                            ToolTip="Reset the recorded input voltage minimum and maximum values. Useful after a power event to start tracking fresh." />
                                    <Button Style="{StaticResource AccentButton}" Content="🔄 Restart NUT" 
                                            Command="{Binding RestartNutCommand}" Margin="0,0,8,4"
                                            ToolTip="Kill and restart the NUT driver (usbhid-ups) and data server (upsd). Use this if the dashboard shows all zeros or 'Unknown' — it means the USB driver process crashed. Data will resume in ~10 seconds." />
                                    <Button Style="{StaticResource AccentButton}" Content="📜 Load History" 
                                            Command="{Binding LoadHistoryCommand}" Margin="0,0,8,4"
                                            ToolTip="Reload the recent events list from the service database. Shows the last 200 power events with timestamps and details." />
                                </WrapPanel>
                                <TextBlock Text="{Binding CommandResult}" 
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== BEEPER PAGE ========== -->
                    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource PageVis}, ConverterParameter=Beeper}">

                        <TextBlock Text="Beeper Configuration" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                        <!-- Current status -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CURRENT UPS BEEPER STATUS" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Shows the live hardware beeper state reported by the UPS. Enabled means the UPS will audibly beep on power events." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding BeeperStatus}" Style="{StaticResource MetricValue}" Margin="0,0,16,0" />
                                    <Button Style="{StaticResource AccentButton}" Content="Toggle Beeper" 
                                            Command="{Binding ToggleBeeperCommand}" FontSize="12" Padding="12,4" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="This sends an instant command to the UPS hardware to enable or disable the beeper." 
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Beeper mode -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BEEPER MODE" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Controls how the service manages the UPS beeper. AlwaysOff/AlwaysOn use EEPROM-persistent commands (beeper.off/beeper.on) that survive power cycles. Scheduled and MuteOnBatteryOnly use session-level commands." />
                                </StackPanel>
                                <ComboBox Style="{StaticResource DarkComboBox}" Width="220" HorizontalAlignment="Left" Margin="0,4,0,0"
                                          ItemsSource="{Binding BeeperModes}" SelectedItem="{Binding SelectedBeeperMode}" />
                                <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        AlwaysOn — Beeper stays enabled at all times.
                                        AlwaysOff — Beeper is always muted.
                                        Scheduled — Beeper is muted/unmuted according to the schedule below.
                                        MuteOnBatteryOnly — Beeper is silenced only when UPS switches to battery power.
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Schedule (visible when Scheduled mode) -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="SCHEDULE ENTRIES" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource AccentButton}" Content="+ Add Entry" Margin="12,0,0,0"
                                            Command="{Binding AddScheduleEntryCommand}" FontSize="11" Padding="8,3" />
                                </StackPanel>
                                <TextBlock Text="Define time windows when the beeper should be muted. Times use 24-hour format (HH:mm)."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding BeeperSchedule}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <ComboBox Style="{StaticResource DarkComboBox}" Width="100" Margin="0,0,8,0"
                                                              ItemsSource="{Binding DataContext.DaysOfWeek, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Day}" />
                                                    <TextBox Style="{StaticResource DarkTextBox}" Width="60" Text="{Binding StartTime}" Margin="0,0,4,0" />
                                                    <TextBlock Text="to" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0" />
                                                    <TextBox Style="{StaticResource DarkTextBox}" Width="60" Text="{Binding EndTime}" Margin="0,0,8,0" />
                                                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Muted" IsChecked="{Binding IsMuted}" 
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Content="✕" FontSize="11" Padding="6,2" Cursor="Hand"
                                                            Background="Transparent" Foreground="{StaticResource RedBrush}" BorderThickness="0"
                                                            Command="{Binding DataContext.RemoveScheduleEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Save -->
                        <StackPanel Orientation="Horizontal" Margin="4,4,4,8">
                            <Button Style="{StaticResource AccentButton}" Content="💾 Save Configuration" 
                                    Command="{Binding SaveConfigCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding ConfigStatus}" Foreground="{StaticResource TextDimBrush}" 
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== EVENTS PAGE ========== -->
                    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource PageVis}, ConverterParameter=Events}">

                        <TextBlock Text="Event History" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource AccentButton}" Content="🔄 Load History" 
                                            Command="{Binding LoadHistoryCommand}" Margin="0,0,12,0" />
                                    <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                               Text="{Binding RecentEvents.Count, StringFormat='{}{0} events'}" />
                                </StackPanel>
                                <TextBlock Text="Shows the last 200 events from the UPS monitoring service. Events are also pushed in real-time when connected."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding RecentEvents}" AutoGenerateColumns="False"
                                          IsReadOnly="True" MaxHeight="500" 
                                          Background="Transparent" Foreground="{StaticResource TextBrush}"
                                          GridLinesVisibility="None" BorderThickness="0"
                                          RowBackground="{StaticResource CardBrush}"
                                          AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                          HeadersVisibility="Column">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                            <Setter Property="Padding" Value="8,4" />
                                            <Setter Property="FontSize" Value="11" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160" />
                                        <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="140" />
                                        <DataGridTextColumn Header="UPS" Binding="{Binding UpsName}" Width="80" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== SHUTDOWN PAGE ========== -->
                    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource PageVis}, ConverterParameter=Shutdown}">

                        <TextBlock Text="Shutdown Configuration" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                        <!-- Enable/Disable -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AUTO-SHUTDOWN" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="When enabled, the computer will automatically shut down or hibernate when UPS battery drops below the configured thresholds during a power outage. The UPS sends shutdown.return to schedule a restart when power returns." />
                                </StackPanel>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Margin="0,4,0,0"
                                          Content="Enable automatic shutdown on battery" IsChecked="{Binding ShutdownEnabled}" />
                                <TextBlock Text="When enabled, the system will automatically shut down or hibernate when battery thresholds are reached during a power outage."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Thresholds -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="THRESHOLDS" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Shutdown triggers when EITHER the battery percentage drops below the battery threshold OR the estimated remaining runtime falls below the runtime threshold. Both are checked every poll cycle (2 seconds)." />
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Battery threshold (%)" Style="{StaticResource FormLabel}" 
                                               Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Shutdown triggers when battery charge drops below this percentage (e.g. 20 means shutdown at 20% battery)." />
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="80" HorizontalAlignment="Left"
                                             Grid.Row="0" Grid.Column="1" Text="{Binding ShutdownBatteryThreshold}" />
                                    <TextBlock Text="Runtime threshold (seconds)" Style="{StaticResource FormLabel}" 
                                               Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Shutdown triggers when estimated remaining battery runtime drops below this many seconds (e.g. 120 = 2 minutes remaining)." />
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="80" HorizontalAlignment="Left"
                                             Grid.Row="1" Grid.Column="1" Text="{Binding ShutdownRuntimeThreshold}" />
                                </Grid>
                                <TextBlock Text="Shutdown triggers when battery drops below the threshold OR remaining runtime falls below the specified seconds."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Grace period + hibernate -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SHUTDOWN OPTIONS" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Configure how the system shuts down. Grace period gives time to cancel if power returns. Hibernate preserves your session. Custom command overrides the default shutdown /s /t 0." />
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Grace period (seconds)" Style="{StaticResource FormLabel}" VerticalAlignment="Center"
                                               ToolTip="Number of seconds to wait before executing shutdown. If power is restored during this window, shutdown is cancelled." />
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="80" HorizontalAlignment="Left"
                                             Grid.Column="1" Text="{Binding ShutdownGracePeriod}" />
                                </Grid>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Margin="0,8,0,0"
                                          Content="Use hibernate instead of shutdown" IsChecked="{Binding ShutdownUseHibernate}" />
                                <TextBlock Text="CUSTOM SHUTDOWN COMMAND" Style="{StaticResource FormLabel}" Margin="0,12,0,4" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ShutdownCustomCommand}" 
                                         Width="400" HorizontalAlignment="Left" />
                                <TextBlock Text="Optional: Override the default system shutdown with a custom command (e.g., shutdown /s /t 0). Leave empty for default behavior."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="4,4,4,8">
                            <Button Style="{StaticResource AccentButton}" Content="💾 Save Configuration" 
                                    Command="{Binding SaveConfigCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding ConfigStatus}" Foreground="{StaticResource TextDimBrush}" 
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== ALERTS PAGE ========== -->
                    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource PageVis}, ConverterParameter=Alerts}">

                        <TextBlock Text="Alert Configuration" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                        <!-- Email settings -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EMAIL NOTIFICATIONS" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Send email alerts via SMTP when selected UPS events occur. Supports STARTTLS (port 587), SSL (port 465), or plain SMTP (port 25). Uses MailKit for reliable delivery." />
                                </StackPanel>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Margin="0,4,0,0"
                                          Content="Enable email alerts" IsChecked="{Binding EmailEnabled}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SMTP Host" Style="{StaticResource FormLabel}" Grid.Row="0" VerticalAlignment="Center"
                                               ToolTip="SMTP server hostname, e.g. smtp.gmail.com, smtp.office365.com" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Grid.Row="0" Grid.Column="1" 
                                             Text="{Binding SmtpHost}" Width="300" HorizontalAlignment="Left" />
                                    <TextBlock Text="SMTP Port" Style="{StaticResource FormLabel}" Grid.Row="1" VerticalAlignment="Center"
                                               ToolTip="587 for STARTTLS (recommended), 465 for implicit SSL, 25 for unencrypted" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Grid.Row="1" Grid.Column="1" 
                                             Text="{Binding SmtpPort}" Width="80" HorizontalAlignment="Left" />
                                    <TextBlock Text="Use TLS" Style="{StaticResource FormLabel}" Grid.Row="2" VerticalAlignment="Center"
                                               ToolTip="Enable STARTTLS encryption for the SMTP connection. Recommended for security." />
                                    <CheckBox Style="{StaticResource DarkCheckBox}" Grid.Row="2" Grid.Column="1" IsChecked="{Binding SmtpUseTls}" />
                                    <TextBlock Text="Username" Style="{StaticResource FormLabel}" Grid.Row="3" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Grid.Row="3" Grid.Column="1" 
                                             Text="{Binding SmtpUsername}" Width="300" HorizontalAlignment="Left" />
                                    <TextBlock Text="Password" Style="{StaticResource FormLabel}" Grid.Row="4" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Grid.Row="4" Grid.Column="1" 
                                             Text="{Binding SmtpPassword}" Width="300" HorizontalAlignment="Left" />
                                    <TextBlock Text="From Address" Style="{StaticResource FormLabel}" Grid.Row="5" VerticalAlignment="Center"
                                               ToolTip="The sender email address shown in alert emails" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Grid.Row="5" Grid.Column="1" 
                                             Text="{Binding EmailFrom}" Width="300" HorizontalAlignment="Left" />
                                    <TextBlock Text="To Addresses" Style="{StaticResource FormLabel}" Grid.Row="6" VerticalAlignment="Center"
                                               ToolTip="Comma-separated list of recipient email addresses that will receive alerts" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Grid.Row="6" Grid.Column="1" 
                                             Text="{Binding EmailTo}" Width="400" HorizontalAlignment="Left" />
                                </Grid>
                                <TextBlock Text="Comma-separated list of recipient email addresses."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Webhook URLs -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="WEBHOOK NOTIFICATIONS" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="HTTP POST JSON event data to these URLs when events occur. Works with Slack incoming webhooks, Discord webhooks, Microsoft Teams connectors, or any custom HTTP endpoint." />
                                </StackPanel>
                                <TextBlock Text="Enter webhook URLs (one per line). The service will POST JSON event data to each URL."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,4" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding WebhookUrlsText}" 
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120" 
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <!-- Event types -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ENABLED EVENT TYPES" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Only checked event types will trigger email and webhook notifications. Uncheck events you don't want to be alerted about to reduce noise." />
                                </StackPanel>
                                <TextBlock Text="Select which events trigger email and webhook notifications."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,8" />
                                <ItemsControl ItemsSource="{Binding AlertEventTypes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource DarkCheckBox}" 
                                                      Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" 
                                                      Width="180" Margin="0,2,8,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="4,4,4,8">
                            <Button Style="{StaticResource AccentButton}" Content="💾 Save Configuration" 
                                    Command="{Binding SaveConfigCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding ConfigStatus}" Foreground="{StaticResource TextDimBrush}" 
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== SCRIPTS PAGE ========== -->
                    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource PageVis}, ConverterParameter=Scripts}">

                        <TextBlock Text="Script Triggers" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="CONFIGURED TRIGGERS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Each trigger runs a script or program when the selected UPS event occurs. Scripts execute under the SYSTEM service account. Environment variables EATONUSBCONTROLLER_EVENT, EATONUSBCONTROLLER_UPS, and EATONUSBCONTROLLER_DETAILS are set automatically." />
                                    <Button Style="{StaticResource AccentButton}" Content="+ Add Trigger" Margin="12,0,0,0"
                                            Command="{Binding AddScriptTriggerCommand}" FontSize="11" Padding="8,3" />
                                </StackPanel>
                                <TextBlock Text="Execute scripts or programs when specific UPS events occur. Scripts run with the service account permissions."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ScriptTriggerList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Event:" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                       ToolTip="The UPS event that triggers this script (e.g. PowerLost, BatteryLow, ShutdownInitiated)" />
                                                            <ComboBox Style="{StaticResource DarkComboBox}" Width="160"
                                                                      ItemsSource="{Binding DataContext.PowerEventTypeNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding EventType}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Script:" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                       ToolTip="Full path to the script or executable (e.g. C:\Scripts\notify.ps1 or C:\Tools\backup.bat)" />
                                                            <TextBox Style="{StaticResource DarkTextBox}" Width="350" Text="{Binding ScriptPath}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Args:" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                       ToolTip="Command-line arguments passed to the script. Use %EATONUSBCONTROLLER_EVENT% to include the event name." />
                                                            <TextBox Style="{StaticResource DarkTextBox}" Width="250" Text="{Binding Arguments}" Margin="0,0,8,0" />
                                                            <TextBlock Text="Timeout:" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                       ToolTip="Maximum seconds the script can run before being killed. Default 30. Set higher for long-running tasks like backups." />
                                                            <TextBox Style="{StaticResource DarkTextBox}" Width="60" Text="{Binding TimeoutSeconds}" />
                                                            <TextBlock Text="s" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" FontSize="14" Padding="8,4" Cursor="Hand" VerticalAlignment="Top"
                                                            Background="Transparent" Foreground="{StaticResource RedBrush}" BorderThickness="0"
                                                            Command="{Binding DataContext.RemoveScriptTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="4,4,4,8">
                            <Button Style="{StaticResource AccentButton}" Content="💾 Save Configuration" 
                                    Command="{Binding SaveConfigCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding ConfigStatus}" Foreground="{StaticResource TextDimBrush}" 
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== NUT / ADVANCED PAGE ========== -->
                    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource PageVis}, ConverterParameter=NUT}">

                        <TextBlock Text="NUT / Advanced" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                        <!-- NUT connection info -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="NUT SERVICE STATUS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Shows whether the NUT UPS driver (usbhid-ups) and data server (upsd) processes are running, and whether the service has an active TCP connection to upsd on port 3493." />
                                    <Button Style="{StaticResource AccentButton}" Content="🔄 Refresh" Margin="12,0,0,0"
                                            Command="{Binding LoadNutInfoCommand}" FontSize="11" Padding="8,3" />
                                </StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="UPS Driver" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="❌ Stopped" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NutDriverRunning}" Value="True">
                                                            <Setter Property="Text" Value="✅ Running" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="upsd Server" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="❌ Stopped" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NutUpsdRunning}" Value="True">
                                                            <Setter Property="Text" Value="✅ Running" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="NUT Connection" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="❌ Disconnected" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NutServiceConnected}" Value="True">
                                                            <Setter Property="Text" Value="✅ Connected" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- NUT configuration -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="NUT CONFIGURATION" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Configure credentials for the local NUT server. Saving updates both appsettings.json and upsd.users, then restarts NUT." />
                                </StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Host" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding NutHost}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Port" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding NutPort}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="UPS Name" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding NutUpsName}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </StackPanel>
                                </UniformGrid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Username" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding NutUsername, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="Password" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                    <TextBox Grid.Column="3" Style="{StaticResource DarkTextBox}" Text="{Binding NutPassword, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Save Credentials"
                                            Command="{Binding SaveConfigCommand}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding ConfigStatus}" Foreground="{StaticResource TextDimBrush}"
                                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Available Commands -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="UPS COMMANDS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Instant commands supported by your UPS hardware. These are sent via NUT's INSTCMD protocol. Common commands include beeper control, battery tests, and shutdown/restart. Click Load Commands to query available commands from your UPS." />
                                    <Button Style="{StaticResource AccentButton}" Content="Load Commands" Margin="12,0,0,0"
                                            Command="{Binding LoadNutCommandsCommand}" FontSize="11" Padding="8,3" />
                                </StackPanel>
                                <TextBlock Text="Available instant commands supported by your UPS. Select one and click Send."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="Common: beeper.enable / beeper.disable / beeper.mute — Beeper control  |  beeper.off / beeper.on — EEPROM-persistent beeper  |  test.battery.start.quick / test.battery.start.deep — Battery tests  |  test.battery.stop — Stop running test  |  shutdown.return — Shut down UPS &amp; restart when power returns  |  shutdown.stayoff — Shut down UPS permanently  |  shutdown.stop — Cancel pending shutdown  |  load.off — Turn off UPS output immediately  |  load.on — Turn on UPS output  |  load.off.delay / load.on.delay — Delayed output control  |  bypass.start / bypass.stop — Bypass mode  |  calibrate.start / calibrate.stop — Runtime calibration  |  reset.input.minmax — Reset input voltage min/max  |  reset.watchdog — Reset watchdog timer  |  outlet.1.shutdown.return / outlet.1.load.off / outlet.1.load.on — Outlet-specific commands" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ComboBox Style="{StaticResource DarkComboBox}" Width="250"
                                              ItemsSource="{Binding AvailableCommands}" SelectedItem="{Binding SelectedCommand}" />
                                    <Button Style="{StaticResource AccentButton}" Content="▶ Send" Margin="8,0,0,0"
                                            Command="{Binding SendNutInstantCommandCommand}" FontSize="12" Padding="12,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Writable Variables -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="WRITABLE VARIABLES" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="UPS variables that can be modified via NUT's SET command. These control hardware settings like low battery threshold, beeper status, outlet delays, etc. Changes are written directly to the UPS hardware." />
                                    <Button Style="{StaticResource AccentButton}" Content="Load Variables" Margin="12,0,0,0"
                                            Command="{Binding LoadWritableVarsCommand}" FontSize="11" Padding="8,3" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding WritableVariables}" AutoGenerateColumns="False"
                                          IsReadOnly="True" MaxHeight="200" 
                                          Background="Transparent" Foreground="{StaticResource TextBrush}"
                                          GridLinesVisibility="None" BorderThickness="0"
                                          RowBackground="{StaticResource CardBrush}"
                                          AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                          HeadersVisibility="Column">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                            <Setter Property="Padding" Value="8,4" />
                                            <Setter Property="FontSize" Value="11" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Variable" Binding="{Binding Key}" Width="200" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="180" Text="{Binding NutVariableName}" />
                                    <TextBlock Text="=" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="180" Text="{Binding NutVariableValue}" />
                                    <Button Style="{StaticResource AccentButton}" Content="Set" Margin="8,0,0,0"
                                            Command="{Binding SetNutVariableCommand}" FontSize="12" Padding="12,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Command result -->
                        <Border Style="{StaticResource CardBorder}" Margin="4,4,4,8">
                            <StackPanel>
                                <TextBlock Text="COMMAND OUTPUT" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CommandResult}" Foreground="{StaticResource TextBrush}" 
                                           FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
